{
  "name": "minibase-cloudflare",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:d1": "node scripts/test-d1.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:worker": "wrangler deploy --dry-run --outdir work/worker-bundle --config wrangler.example.jsonc && node scripts/test-worker.mjs",
    "build": "wrangler deploy --dry-run --config wrangler.example.jsonc",
    "bootstrap:key": "node scripts/create-bootstrap-key.mjs",
    "migration:checksum": "node scripts/migration-checksum.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:release": "node scripts/test-release-readiness.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:d1 && npm run test:migrations && npm run test:release && npm run test:worker && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "globals": "16.3.0",
    "miniflare": "4.20260722.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "minimatch": "10.2.4"
  }
}
